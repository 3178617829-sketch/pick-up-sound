# 统一换行：源码默认 LF，Windows 脚本用 CRLF
* text=auto eol=lf

*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# 二进制，不做换行与文本合并
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.exe binary
*.dll binary
*.pdb binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
